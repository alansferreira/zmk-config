// This is QUERTY map

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        td_caps: tap_dance_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_CAPS";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  +=   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |   '   |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   \|  |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC   &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                        &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp EQUAL
&kp TAB   &kp Q   &kp W     &kp E     &kp R      &kp T                         &kp Y   &kp U      &kp I      &kp O     &kp P     &to 3
&kp APOS  &kp A   &kp S     &kp D     &kp F      &kp G                         &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp BSLH
&td_caps  &kp Z   &kp X     &kp C     &kp V      &kp B   &none      &none      &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                  &kp LGUI  &kp LALT  &kp LCTRL  &to 1   &kp RET    &kp SPACE  &to 2   &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer_1_fkeys {
            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // | RGB_TOG |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |       |  {[  |   ]}  |       |
            // |         |  F8 |  F9 | F10  | F11  | F12  |                   |      |       | VL_UP |      | C_PP  |       |
            // |         |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    | VL_DN |  (   |   )   |       |
            // |         |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    | MUTE  |  :   |   \   |       |
            //                 |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans  &kp F1  &kp F2  &kp F3   &kp F4   &kp F5                     &none  &none   &none         &kp LBKT  &kp RBKT  &none
&trans  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                    &none  &none   &kp C_VOL_UP  &none     &kp C_PP  &to 3
&none   &none   &none   &none    &none    &none                      &none  &none   &kp C_VOL_DN  &none     &none     &none
&trans  &none   &none   &none    &none    &none    &none     &none   &none  &none   &kp C_MUTE    &none     &kp BSLH  &trans
                &trans  &trans   &trans   &to 0    &trans    &trans  &to 2  &trans  &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer_2_edit {
            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |  {[  |   ]}  |  -_   |
            // |     | INS  | PSCR | GUI   |       |      |                | PGUP | HOME |   ^   | END  | C_PP  |  DEL  |
            // | `~  | ALT  | CTRL | SHIFT |       |      |                |      |   <- |   v   |  ->  |       |       |
            // |     | UNDO | CUT  | COPY  | PASTE |      |      |  |      | PGDN |      |       |      |       |       |
            //              |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans     &none       &none      &none       &none        &none                      &none          &none     &none     &kp LBKT   &kp RBKT  &kp MINUS
&trans     &kp INS     &kp PSCRN  &none       &none        &none                      &kp PG_UP      &kp HOME  &kp UP    &kp END    &none     &to 3
&kp GRAVE  &none       &none      &none       &none        &kp DEL                    &kp BACKSPACE  &kp LEFT  &kp DOWN  &kp RIGHT  &none     &none
&trans     &kp K_UNDO  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &none    &none     &none   &kp PG_DN      &none     &none     &none      &none     &trans
                       &trans     &trans      &trans       &to 1    &trans    &trans  &to 0          &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer_3 {
            bindings = <
&trans  &none  &none   &none   &none   &none                    &none  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTRK  &kp MINUS
&trans  &none  &none   &none   &none   &none                    &none  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none      &to 0
&none   &none  &none   &none   &none   &none                    &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none      &kp KP_DIVIDE
&trans  &none  &none   &none   &none   &none  &none     &none   &none  &none         &kp NUMBER_0  &none         &none      &trans
               &trans  &trans  &trans  &to 1  &trans    &trans  &to 2  &trans        &trans        &trans
            >;
        };
    };
};
